# Copy to .env and replace every value, or run infra/Initialize-Local.ps1.
# Local development only. Never reuse these accounts for a deployment.
POSTGRES_PASSWORD=replace-with-random-database-password
DINDER_DATABASE_PASSWORD=replace-with-random-app-database-password
DINDER_CHEF_PASSWORD=replace-with-unique-12-plus-character-password
DINDER_MEMBER_PASSWORD=replace-with-another-unique-12-plus-character-password
